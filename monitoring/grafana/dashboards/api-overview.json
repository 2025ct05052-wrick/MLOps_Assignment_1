{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (path) (rate(heart_disease_api_requests_total[5m]))", "legendFormat": "{{path}}", "refId": "A"}],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(heart_disease_api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (prediction) (increase(heart_disease_predictions_total[1h]))", "legendFormat": "class {{prediction}}", "refId": "A"}],
      "title": "Predictions by class (last hour)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum(rate(heart_disease_api_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(heart_disease_api_requests_total[5m])), 0.000001)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "Server error ratio",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["mlops", "heart-disease"],
  "time": {"from": "now-6h", "to": "now"},
  "title": "Heart Disease API Overview",
  "uid": "heart-disease-api",
  "version": 1
